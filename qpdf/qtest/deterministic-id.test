#!/usr/bin/env perl
require 5.008;
use warnings;
use strict;
use File::Copy;

unshift(@INC, '.');
require qpdf_test_helpers;

chdir("qpdf") or die "chdir testdir failed: $!\n";

require TestDriver;

cleanup();

my $td = new TestDriver('deterministic-id');

my $n_tests = 40;

# Do not use qpdf-test-compare in this test suite since it ignores
# /ID[1].

foreach my $d ('nn', 'ny', 'yn', 'yy')
{
    my $linearize = ($d =~ m/^y/);
    my $ostream = ($d =~ m/y$/);
    # The deterministic ID is a function of all the data in the file.
    # As such, it is affected by which zlib implementation is in use.
    # The important thing is that the ID is the same if a file is
    # generated the same way more than once, so rather than comparing
    # the output file to a known output, compare subsequent outputs
    # with each other.
    foreach my $out ('a.pdf', 'b.pdf')
    {
        $td->runtest("deterministic ID: linearize/ostream=$d",
                     {$td->COMMAND =>
                          "qpdf -deterministic-id" .
                          ($linearize ? " -linearize" : "") .
                          " -object-streams=" . ($ostream ? "generate" : "disable") .
                          " deterministic-id-in.pdf $out"},
                     {$td->STRING => "",
                          $td->EXIT_STATUS => 0});
    }
    $td->runtest("compare files",
                 {$td->FILE => "a.pdf"},
                 {$td->FILE => "b.pdf"});
    check_id('a.pdf');
    if ($d eq 'nn')
    {
        # Save for the C API test
        copy("a.pdf", 'c.pdf');
    }
}

$td->runtest("deterministic ID with encryption",
             {$td->COMMAND => "qpdf -deterministic-id encrypted-with-images.pdf a.pdf"},
             {$td->STRING => "qpdf: QPDFWriter: unable to generated a deterministic ID " .
                    "because the file to be written is encrypted (even though the file " .
                    "may not require a password)\n",
             $td->EXIT_STATUS => 2},
             $td->NORMALIZE_NEWLINES);
$td->runtest("deterministic ID (C API)",
             {$td->COMMAND =>
                  "qpdf-ctest 19 deterministic-id-in.pdf '' a.pdf"},
             {$td->STRING => "C test 19 done\n",
                  $td->EXIT_STATUS => 0},
             $td->NORMALIZE_NEWLINES);
$td->runtest("compare files",
             {$td->FILE => "a.pdf"},
             {$td->FILE => "c.pdf"});

# SOURCE_DATE_EPOCH implies --deterministic-id for unencrypted output.
foreach my $linearize ('', ' --linearize')
{
    {
        delete local $ENV{'SOURCE_DATE_EPOCH'};
        $td->runtest("deterministic ID without SOURCE_DATE_EPOCH$linearize",
                     {$td->COMMAND =>
                          "qpdf --deterministic-id$linearize deterministic-id-in.pdf d.pdf"},
                     {$td->STRING => "", $td->EXIT_STATUS => 0});
    }
    local $ENV{'SOURCE_DATE_EPOCH'} = '1612969439';
    foreach my $out ('a.pdf', 'b.pdf')
    {
        $td->runtest("SOURCE_DATE_EPOCH$linearize",
                     {$td->COMMAND => "qpdf$linearize deterministic-id-in.pdf $out"},
                     {$td->STRING => "", $td->EXIT_STATUS => 0});
    }
    $td->runtest("compare files",
                 {$td->FILE => "a.pdf"},
                 {$td->FILE => "b.pdf"});
    $td->runtest("compare with deterministic ID",
                 {$td->FILE => "a.pdf"},
                 {$td->FILE => "d.pdf"});
}

{
    # With encryption, there is no deterministic ID, but the ID is computed with the fixed time.
    # 128-bit RC4 has no other random data.
    local $ENV{'SOURCE_DATE_EPOCH'} = '1612969439';
    foreach my $out ('a.pdf', 'b.pdf')
    {
        $td->runtest("SOURCE_DATE_EPOCH with encryption",
                     {$td->COMMAND =>
                          "qpdf --allow-weak-crypto --encrypt --bits=128 --use-aes=n --" .
                          " deterministic-id-in.pdf e.pdf"},
                     {$td->STRING => "", $td->EXIT_STATUS => 0});
        rename("e.pdf", $out);
    }
    $td->runtest("compare files",
                 {$td->FILE => "a.pdf"},
                 {$td->FILE => "b.pdf"});
}

{
    # Forcing an old version drops AES encryption after the ID was generated from the encryption
    # parameters, so there is no deterministic ID, but the output is still reproducible.
    local $ENV{'SOURCE_DATE_EPOCH'} = '1612969439';
    foreach my $out ('a.pdf', 'b.pdf')
    {
        $td->runtest("SOURCE_DATE_EPOCH with encryption removed",
                     {$td->COMMAND => "qpdf --force-version=1.4 V4-aes.pdf e.pdf"},
                     {$td->STRING => "", $td->EXIT_STATUS => 0});
        rename("e.pdf", $out);
    }
    $td->runtest("compare files",
                 {$td->FILE => "a.pdf"},
                 {$td->FILE => "b.pdf"});
}

foreach my $v ('potato', '-1', '12a', '99999999999999999999')
{
    local $ENV{'SOURCE_DATE_EPOCH'} = $v;
    $td->runtest("invalid SOURCE_DATE_EPOCH $v",
                 {$td->COMMAND => "qpdf deterministic-id-in.pdf a.pdf"},
                 {$td->STRING => "qpdf: invalid value for SOURCE_DATE_EPOCH: $v\n",
                      $td->EXIT_STATUS => 2},
                 $td->NORMALIZE_NEWLINES);
}

{
    local $ENV{'SOURCE_DATE_EPOCH'} = '';
    $td->runtest("empty SOURCE_DATE_EPOCH",
                 {$td->COMMAND => "qpdf deterministic-id-in.pdf a.pdf"},
                 {$td->STRING => "", $td->EXIT_STATUS => 0});
}

cleanup();
$td->report($n_tests);

sub check_id
{
    my $f = shift;
    chomp(my $id = `qpdf --show-object=trailer $f`);
    if ($id =~ m,.*/ID \[ <(9b1c69409fc9a5f50e44b9588e3e60f8)> <(.{32})>,)
    {
        my $id0 = $1;
        my $id1 = $2;
        $td->runtest("ID fields differ",
                     {$td->STRING => $id0 ne $id1 ? "YES\n" : "$id0 $id1\n"},
                     {$td->STRING => "YES\n"});
    }
    else
    {
        $td->runtest("checked ID",
                     {$td->STRING => "YES\n"},
                     {$td->STRING => "$id\n"});
    }
}
